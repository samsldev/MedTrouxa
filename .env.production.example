# ======== MedTrouxa — produção ========
# Gere segredos com:  openssl rand -base64 48
DOMAIN=app.medtrouxa.com.br

# Banco (senhas fortes, 16+ caracteres)
DB_USER=medtrouxa
DB_NAME=medtrouxa
DB_PASSWORD=
PG_ADMIN_PASSWORD=
REPMGR_PASSWORD=
PGPOOL_ADMIN_PASSWORD=

# Cache
REDIS_PASSWORD=

# Autenticação (32+ caracteres aleatórios)
JWT_SECRET=
# Criptografia de dados sensíveis em repouso (segredos do 2FA): openssl rand -base64 32
# ATENÇÃO: se perder ou trocar esta chave, o 2FA por app de todos os usuários para de funcionar
ENCRYPTION_KEY=

# Primeiro administrador (senha forte; depois pode remover daqui)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Pagamentos — Mercado Pago (Suas integrações > Credenciais de produção / Webhooks)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# E-mail transacional (recuperação de senha), ex.: smtps://usuario:senha@smtp.provedor.com:465
SMTP_URL=
MAIL_FROM=MedTrouxa <nao-responda@medtrouxa.com.br>

# IA (opcional)
ANTHROPIC_API_KEY=

# ======== Nota fiscal de serviço (NFS-e Nacional) ========
# Códigos, regime e alíquotas DEVEM ser confirmados pelo contador. Comece em homologacao.
# Converta o certificado A1 (.pfx) uma vez e coloque os arquivos em ./secrets/nfse/:
#   openssl pkcs12 -in empresa.pfx -clcerts -nokeys -out secrets/nfse/nfse-cert.pem
#   openssl pkcs12 -in empresa.pfx -nocerts -nodes -out secrets/nfse/nfse-key.pem
#   chmod 600 secrets/nfse/*.pem
NFSE_ENABLED=0
NFSE_ENV=homologacao
NFSE_CNPJ=
NFSE_IM=
# Código IBGE do município do prestador (7 dígitos)
NFSE_CITY_CODE=
NFSE_SERIES=1
NFSE_TRIB_NAC=010301
NFSE_NBS=
NFSE_SIMPLES_OPTION=3
NFSE_SIMPLES_REGIME=1
NFSE_SPECIAL_REGIME=0
# Texto do serviço na nota (opcional)
NFSE_DESCRIPTION=
# Raízes ICP-Brasil extras, se o TLS com o gov.br exigir (caminho dentro do container)
NFSE_CA_BUNDLE_PATH=
# Reforma tributária (opcional; todos ou nenhum)
NFSE_IBSCBS_CINDOP=
NFSE_IBSCBS_CST=
NFSE_IBSCBS_CCLASSTRIB=

# Backups criptografados
BACKUP_PASSPHRASE=
BACKUP_KEEP_DAYS=14

# Conteúdo de exemplo (questões, baralhos, cronogramas) no primeiro boot
SEED_SAMPLE_CONTENT=true

# Rodapé (opcionais)
LEGAL_NAME=
CNPJ=
CONTACT_EMAIL=
WHATSAPP=
INSTAGRAM=
