# ======== MedTrouxa — produção ========
# Gere segredos com:  openssl rand -base64 48
DOMAIN=app.medtrouxa.com.br

# Banco (senhas fortes, 16+ caracteres)
DB_USER=medtrouxa
DB_NAME=medtrouxa
DB_PASSWORD=
PG_ADMIN_PASSWORD=
REPMGR_PASSWORD=
PGPOOL_ADMIN_PASSWORD=

# Cache
REDIS_PASSWORD=

# Autenticação (32+ caracteres aleatórios)
JWT_SECRET=
# Criptografia de dados sensíveis em repouso (segredos do 2FA): openssl rand -base64 32
# ATENÇÃO: se perder ou trocar esta chave, o 2FA por app de todos os usuários para de funcionar
ENCRYPTION_KEY=

# Primeiro administrador (senha forte; depois pode remover daqui)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Pagamentos — Mercado Pago (Suas integrações > Credenciais de produção / Webhooks)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# E-mail transacional (recuperação de senha), ex.: smtps://usuario:senha@smtp.provedor.com:465
SMTP_URL=
MAIL_FROM=MedTrouxa <nao-responda@medtrouxa.com.br>

# IA (opcional)
ANTHROPIC_API_KEY=

# Backups criptografados
BACKUP_PASSPHRASE=
BACKUP_KEEP_DAYS=14

# Conteúdo de exemplo (questões, baralhos, cronogramas) no primeiro boot
SEED_SAMPLE_CONTENT=true

# Rodapé (opcionais)
LEGAL_NAME=
CNPJ=
CONTACT_EMAIL=
WHATSAPP=
INSTAGRAM=
