 * All information contained herein is, and remains, the property of
 * Samuel S. L. and its suppliers, if any.
 *
 * The intellectual, technical, creative, and software concepts contained
 * herein are proprietary to Samuel S. L. and its suppliers and
 * are protected by copyright law, trade secret law, and other applicable
 * intellectual property laws in the Netherlands, the European Union, and
 * other foreign jurisdictions.
 *
 * Where applicable, such rights may be registered, recorded, or protected
 * with the competent authorities of the Government of the Netherlands,
 * the European Union, and/or other relevant jurisdictions.
 *
 * Dissemination of this information, reproduction of this material,
 * modification, distribution, disclosure, or commercial use is strictly
 * forbidden unless prior written permission is obtained from
 * Samuel S. L.
 *
 * @commercialUse Commercial use permitted only with prior written permission from Samuel S. L.
 *
 * <DETAILED_DESCRIPTION>:
 * - Copy to .env and fill Stripe test-mode keys until go-live
 * - COOKIE_SECURE=0 is required for localhost HTTP; production must use HTTPS
 * - COOKIE_SECRET HMAC-signs the session cookie (min 16 bytes)
 * - CHAT_KEY_SECRET encrypts Chat keys at rest (min 16 bytes, distinct from the other secrets)
 * - FAELITH_API_URL is the gateway the Web Chat calls; defaults to the test stack
 * - STRIPE_INTRO_COUPON_ID is the one-time 50 percent coupon used by the landing intro offer
 *   and the cancel retention offer; unset disables both
 * - STRIPE_PRICE_*_YEARLY are optional yearly Price IDs used when the SPA sends interval=yearly
 * - MFA_SECRET seals TOTP seeds and MACs one-time codes (min 32 bytes, distinct, back it up)
 * - SMTP_* is required in production; FAELITH_ALLOW_LOG_MAILER=1 logs codes instead (dev only)
 */

LISTEN_ADDR=127.0.0.1:8081
PUBLIC_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=0
COOKIE_SECRET=replace-with-32-plus-bytes-of-entropy
DATABASE_URL=postgres://faelith:faelith@127.0.0.1:5432/faelith
REDIS_URL=redis://127.0.0.1:6379
FAELITH_KEY_PEPPER=replace-with-32-plus-bytes-of-entropy
# Encrypts server-managed purpose=chat keys at rest; must differ from COOKIE_SECRET and FAELITH_KEY_PEPPER.
CHAT_KEY_SECRET=replace-with-a-different-32-plus-bytes-of-entropy
# Seals TOTP seeds and MACs one-time codes; must differ from every other secret.
MFA_SECRET=replace-with-yet-another-32-plus-bytes-of-entropy
# Transactional email for signup codes and 2FA. Use a provider relay (SES, Postmark, Resend, Brevo).
# SMTP_SECURITY: starttls (587, default) | tls (465) | plain (loopback dev relay only).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Faelith <no-reply@faelithindustries.com>
# Dev only: write emails (including codes) to the log when SMTP_HOST is empty.
FAELITH_ALLOW_LOG_MAILER=1
# Gateway the website Chat talks to. Unset = test stack (127.0.0.1:8788); production gateway is 127.0.0.1:8080.
FAELITH_API_URL=http://127.0.0.1:8788
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_STARTER=price_replace_starter
STRIPE_PRICE_PRO=price_replace_pro
STRIPE_PRICE_MAX=price_replace_max
STRIPE_PRICE_ULTRA=price_replace_ultra
STRIPE_PRICE_SCALE=price_replace_scale
STRIPE_PRICE_STARTER_YEARLY=price_replace_starter_yearly
STRIPE_PRICE_PRO_YEARLY=price_replace_pro_yearly
STRIPE_PRICE_MAX_YEARLY=price_replace_max_yearly
STRIPE_PRICE_ULTRA_YEARLY=price_replace_ultra_yearly
STRIPE_PRICE_SCALE_YEARLY=price_replace_scale_yearly
STRIPE_PRICE_CREDITS_10=price_replace_credits_10
STRIPE_PRICE_CREDITS_50=price_replace_credits_50
STRIPE_PRICE_CREDITS_100=price_replace_credits_100
STRIPE_INTRO_COUPON_ID=
# Comma-separated emails allowed into /app/admin (each needs TOTP enabled)
ADMIN_EMAILS=
# Admin profit report tax defaults in percent (Simples III: 6 / 0; Presumido: ~15 / 0; Lucro Real: ~12 / 34)
ADMIN_TAX_REVENUE_PCT=6
ADMIN_TAX_PROFIT_PCT=0
# Fallback Stripe fee in percent when the period has no measured payments
ADMIN_PAYMENT_FEE_PCT=5

# ---------------------------------------------------------------------------
# NFS-e Nacional (own emitter). Off unless NFSE_ENABLED=1. Codes and regime must be
# confirmed by the accountant (see BRIEFING_CONTADOR.md). Stripe must send invoice.paid.
# Convert the A1 certificate once (keep both files outside the repository, mode 600):
#   openssl pkcs12 -in empresa.pfx -clcerts -nokeys -out nfse-cert.pem
#   openssl pkcs12 -in empresa.pfx -nocerts -nodes -out nfse-key.pem
# ---------------------------------------------------------------------------
NFSE_ENABLED=0
NFSE_ENV=homologacao
NFSE_CNPJ=
NFSE_IM=
NFSE_CITY_CODE=
NFSE_SERIES=1
NFSE_TRIB_NAC=010301
NFSE_NBS=
NFSE_SIMPLES_OPTION=3
NFSE_SIMPLES_REGIME=1
NFSE_SPECIAL_REGIME=0
NFSE_CERT_PEM_PATH=
NFSE_KEY_PEM_PATH=
# Optional ICP-Brasil root bundle if the government endpoints fail TLS verification
NFSE_CA_BUNDLE_PATH=
# IBS/CBS group (mandatory for Simples Nacional from 2027): set all three or none
NFSE_IBSCBS_CINDOP=
NFSE_IBSCBS_CST=
NFSE_IBSCBS_CCLASSTRIB=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
WEB_DIST=apps/web/dist
